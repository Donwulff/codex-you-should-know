{
  "type": "object",
  "properties": {
    "finding": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "topic": {"type": "string", "minLength": 1, "maxLength": 160},
            "summary": {"type": "string", "minLength": 1, "maxLength": 280},
            "explanation": {"type": "string", "minLength": 1, "maxLength": 1600},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {"type": "string", "minLength": 1, "maxLength": 500}
            },
            "agent_still_working": {"type": "boolean"},
            "assistant_claim": {"type": "boolean"}
          },
          "required": ["topic", "summary", "explanation", "evidence", "agent_still_working", "assistant_claim"],
          "additionalProperties": false
        }
      ]
    },
    "no_finding": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "enum": ["no_concern", "already_disclosed", "in_progress", "insufficient_evidence", "resolved_or_accepted", "already_reported"]
            },
            "reason": {"type": "string", "minLength": 1, "maxLength": 800}
          },
          "required": ["category", "reason"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["finding", "no_finding"],
  "additionalProperties": false
}
